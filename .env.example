# Public port — the gateway hits this.
PORT=8080
HOST=0.0.0.0

# Internal URL of the pi-sdk-runtime container (Image 1).
PI_SDK_RUNTIME_URL=http://pi-sdk-runtime:7000

# Shared secret used to call pi-sdk-runtime. Must match its INTERNAL_SHARED_TOKEN.
INTERNAL_SHARED_TOKEN=change-me-in-prod

# Token the gateway must present in X-Gateway-Token / Authorization to call us.
GATEWAY_SHARED_TOKEN=change-me-in-prod

# Log level.
LOG_LEVEL=info
